<!ATTLIST functional_status feature ( physical_activity | activities_of_daily_living | bathing | dressing | transferring | continence | toileting | feeding | using_transportation | shopping | meal_preparation | housekeeping | laundry | medication_management | financial_management | assistive_device_use | home_safety_concern ) #REQUIRED >
<!ATTLIST functional_status certainty ( negated|possible|hypothetical|positive ) #REQUIRED >
<!ATTLIST functional_status status ( present|history ) #REQUIRED >
<!ATTLIST functional_status experiencer ( patient|other ) #REQUIRED >
<!ATTLIST functional_status exclusion ( yes|no ) #REQUIRED >
<!ATTLIST functional_status comment CDATA #IMPLIED "" >
