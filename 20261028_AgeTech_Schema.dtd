<!ENTITY name "Age_Tech">

<!-- Each tag is a feature class. The specific feature is chosen with the
     "feature" attribute (like certainty and status). All attributes are
     required and have no default, so the annotator must set each one on
     every annotation. In MedTator, type a class name in the tag Filter box,
     or use the feature drop-down on a tag to pick the specific feature.
     Context attributes follow the Annotation Guideline, Section 3. -->

<!-- ===== Goals of Care and Care Planning ===== -->
<!ELEMENT goals_of_care_and_care_planning ( #PCDATA ) >
<!ATTLIST goals_of_care_and_care_planning feature ( goals_of_care | limitation_of_lst | hospice | palliative_care ) #REQUIRED >
<!ATTLIST goals_of_care_and_care_planning certainty ( negated|possible|hypothetical|positive ) #REQUIRED >
<!ATTLIST goals_of_care_and_care_planning status ( present|history ) #REQUIRED >
<!ATTLIST goals_of_care_and_care_planning experiencer ( patient|other ) #REQUIRED >
<!ATTLIST goals_of_care_and_care_planning exclusion ( yes|no ) #REQUIRED >
<!ATTLIST goals_of_care_and_care_planning comment CDATA #IMPLIED "" >
<!-- ===== Fall History ===== -->
<!ELEMENT fall_history ( #PCDATA ) >
<!ATTLIST fall_history feature ( falls | recurrent_falls | fall_injury | fear_of_falling | near_fall | fall_prevention_education ) #REQUIRED >
<!ATTLIST fall_history certainty ( negated|possible|hypothetical|positive ) #REQUIRED >
<!ATTLIST fall_history status ( present|history ) #REQUIRED >
<!ATTLIST fall_history experiencer ( patient|other ) #REQUIRED >
<!ATTLIST fall_history exclusion ( yes|no ) #REQUIRED >
<!ATTLIST fall_history comment CDATA #IMPLIED "" >
