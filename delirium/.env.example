# Copy to .env and edit:  cp .env.example .env
# Relative paths are resolved from the delirium/ folder.

# Folder of clinical notes, one .txt per document
# (naming: patientID_documentID_documentDate.txt)
INPUT_DIR=data/input

# MedTagger writes one .ann file per note here
OUTPUT_DIR=data/output

# Rule set (model) used by MedTagger
RULES_DIR=models/ENACT_DELIRIUM

# MedTator review files (.xml) are written here
MEDTATOR_DIR=data/medtator

# Patient/document-level delirium summary
RESULT_CSV=data/summarized_result.csv

# MedTagger jar and Java memory
MEDTAGGER_JAR=MedTagger-fit-context.jar
JAVA_OPTS="-Xms512M -Xmx2000M"
